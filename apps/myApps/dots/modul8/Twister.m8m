	<string>#print type,param

if type =='KEYDOWN':
	#print type, param
	if param['modifiers']['ALT'] and (param['key'] == "\xc2"):
		update_forward_mode(int(not forward_mode._last_sent_value))

if type == 'MIDI' and param.get('rawEvent', 0) &lt; 0xF8 :	# skip clock and active sensing
	receive_feedback(param)
	midi_registry.receive(param)
	#print('TWISTER MIDI:', type, param)

