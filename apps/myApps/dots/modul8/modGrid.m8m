	<key>SCRIPT_INIT</key>
	<string># modGrid (dots): Modul8's side of the Modul8 mode on the modGrid iPad app.
# dots owns the iPad. In its Modul8 mode it passes the 16 dials (CC 0-15 on channel 1) and the 16
# buttons above the grid (CC 0-15 on channel 2: 127 pressed, 0 released) to the "dots modGrid" port,
# as a Midi Fighter Twister sends its knobs and buttons. This module answers on the same port: dial
# values on channel 1 and button colours (Twister colour values, 0 off) on channel 2, which dots shows
# on the iPad. dots asks for everything again with CC 127 on channel 1. The names on the iPad come
# from dots (its bin/data/modul8.json, or the ones built in for this layout).

LINK_NAME = u'dots modGrid'
REFRESH_CC = 127

device_list = modul8.getMidiDestinationsList()
midiEndPoint = ''
for item in device_list:
	if item == LINK_NAME or item.endswith(u' - ' + LINK_NAME):
		midiEndPoint = item
		break

def update_midi_destinations():
	device_list = modul8.getMidiDestinationsList()
	if len(device_list) &gt; 0:
		module.setAttribute('outPointList', 'TEXTLIST', device_list)
		if midiEndPoint in device_list:
			module.setValue('outPointList', 0, midiEndPoint)

update_midi_destinations()

def is_link(source):
	# Modul8 may name a MIDI source "Device - Port", so match on the port's name too
	return bool(midiEndPoint) and (source == midiEndPoint or source.endswith(u' - ' + midiEndPoint) or midiEndPoint.endswith(u' - ' + source))


class MidiRegistry(object):

	def __init__(self):
		self._dict = {}

	def register(self, control):
		self._dict[control.name] = control

	def receive(self, param):
		if 'message' not in param:
			return
		name = str(param['channel'])+'*'+str(param['message'])+'*'+str(param['param1'])
		if name in self._dict:
			self._dict[name].receive(param['param2'])


class AttributeRegistry(object):

	def __init__(self):
		self._dict = {}

	def register(self, attribute):
		self._dict[attribute.name] = attribute

	def receive(self, keyword, param, layer):
		name = str(keyword)+'*'+str(layer)
		if name in self._dict:
			self._dict[name].receive(param)

midi_registry = MidiRegistry()
attribute_registry = AttributeRegistry()


class Event(object):

	def __init__(self):
		self._callbacks = []

	def on(self, f):
		self._callbacks.append(f)

	def emit(self, *data):
		for f in self._callbacks:
			f(*data)

	def off(self, f):
		if f in self._callbacks:
			self._callbacks.remove(f)

	def clear(self):
		self._callbacks = []


class Control(Event):
	# A dial or button on the iPad, as dots passes it: a CC on channel 1 (dials) or 2 (buttons)

	def __init__(self, channel, number, m8if=None, *a, **k):
		super(Control, self).__init__(*a, **k)
		self.name = str(channel)+'*CONTROL_CHANGE*'+str(number)
		self.channel = channel
		self.number = number
		self.value = 0
		self._attribute = None
		self._m8if = m8if
		midi_registry.register(self)

	def receive(self, value):
		self.value = value/127.
		self.emit(self)
		self._update_module8_if(value)

	def _send(self, value):
		if midiEndPoint:
			modul8.sendMidi(midiEndPoint, self.channel, 'CONTROL_CHANGE', self.number, int(value))
		self._update_module8_if(value)

	def _update_module8_if(self, value):
		if self._m8if:
			module.setValue(self._m8if, 0, value)

	def send(self, value):
		self.value = value
		self._send(value)

	def send_from_attribute(self, value):
		self._send(float(value)*127.)

	def connect_to(self, attribute):
		if self._attribute:
			self._attribute.off(self.send_from_attribute)
		self._callbacks = []
		self._attribute = attribute
		if self._attribute:
			self.on(attribute.send)
			self._attribute.on(self.send_from_attribute)
		self.update()

	def update(self):
		if self._attribute:
			self._send(float(self._attribute.getValue())*127.)
		elif not len(self._callbacks):
			self._send(0)


class Button(Control):

	def __init__(self, channel, number, is_toggle = False, on_color = 1., off_color = 0., *a, **k):
		super(Button, self).__init__(channel, number, *a, **k)
		self._on_color = on_color
		self._off_color = off_color
		self._is_toggle = is_toggle

	def set_is_toggle(self, value):
		self._is_toggle = bool(value)

	def receive(self, value):
		if self._is_toggle:
			if not value:
				self.value = not self.value
				self.emit(self)
				self.update()
		else:
			self.value = value/127.
			self.emit(self)

	def send_from_attribute(self, value):
		if self._is_toggle:
			self.update()
		else:
			super(Button, self).send_from_attribute(value)

	def _update_module8_if(self, value):
		if self._m8if:
			module.setValue(self._m8if, 0, float(value &gt; 0))

	def update(self):
		if self._attribute:
			value = float(self._attribute.getValue())*self._on_color
			if self._is_toggle:
				self.value = bool(value)
				self._send(self._on_color if self.value else self._off_color)
			else:
				self._send(value if value else self._off_color)
		elif not len(self._callbacks):
			self._send(self._off_color)


class RadioControl(Event):

	def __init__(self, controls = [], offset = 0, on_color = 127., off_color = 0., *a, **k):
		super(RadioControl, self).__init__(*a, **k)
		self._controls = []
		self.set_controls(controls)
		self.value = 0
		self._offset = offset
		self._attribute = None
		self._on_color = on_color
		self._off_color = off_color

	def set_offset(self, value):
		self._offset = value
		self.update()

	def set_controls(self, controls):
		for control in self._controls:
			control.off(self.receive)
		self._controls = controls if controls else []
		for control in self._controls:
			control.on(self.receive)

	def receive(self, control, *a):
		self.value = self._controls.index(control)+self._offset
		self.emit(self)

	def send_from_attribute(self, value):
		self.value = float(value)
		for control in self._controls:
			control._send(float(self._controls.index(control)+self._offset == self.value)*self._on_color)

	def connect_to(self, attribute):
		if self._attribute:
			self._attribute.off(self.send_from_attribute)
		self._callbacks = []
		self._attribute = attribute
		if self._attribute:
			self.on(attribute.send)
			self._attribute.on(self.send_from_attribute)
		self.update()

	def update(self):
		if self._attribute:
			self.send_from_attribute(self._attribute.getValue())


class ToggledShiftableControl(Event):
	# A dial that switches between two attributes, its shift button lit in one colour or the other

	def __init__(self, primary_attribute = None, secondary_attribute = None, toggle_on_color = 127., toggle_off_color = 0., *a, **k):
		super(ToggledShiftableControl, self).__init__(*a, **k)
		self._control = None
		self._shift_control = None
		self._primary_attribute = primary_attribute
		self._secondary_attribute = secondary_attribute
		self._toggle_on_color = toggle_on_color
		self._toggle_off_color = toggle_off_color
		self._shifted = False

	def set_control(self, control):
		self._control = control
		self.assign_control_attribute()

	def set_shift_control(self, control):
		if self._shift_control:
			self._shift_control.off(self.receive_shift_value)
		self._shift_control = control
		if self._shift_control:
			self._shift_control.on(self.receive_shift_value)
		self.update_toggle_color()

	def receive_shift_value(self, control):
		if control.value == 0:
			self._shifted = not self._shifted
			self.assign_control_attribute()
			self.update_toggle_color()

	def assign_control_attribute(self):
		if self._control:
			self._control.connect_to(self._secondary_attribute if self._shifted else self._primary_attribute)

	def update_toggle_color(self):
		if self._shift_control:
			self._shift_control._send(self._toggle_on_color if self._shifted else self._toggle_off_color)


class Attribute(Event):

	def __init__(self, keyword, layer, *a, **k):
		super(Attribute, self).__init__(*a, **k)
		self.name = str(keyword)+'*'+str(layer)
		self.keyword = keyword
		self.layer = layer
		attribute_registry.register(self)

	def receive(self, value):
		self.emit(value)

	def send(self, control):
		modul8.setValue(self.keyword, control.value, self.layer)

	def getValue(self):
		value = modul8.getValue(self.keyword, self.layer)
		return float(value) if value else 0.


class ScriptAttribute(Event):

	def __init__(self, script_attribute = None, *a, **k):
		super(ScriptAttribute, self).__init__(*a, **k)
		self._script_attribute = script_attribute
		self._last_sent_value = 0.

	def send(self, control):
		self._last_sent_value = int(float(control.value))
		if self._script_attribute:
			self._script_attribute(self._last_sent_value)

	def getValue(self):
		return float(self._last_sent_value) if self._last_sent_value else 0.


# The iPad's dials (in two rows of 8 there) and the two rows of buttons above the grid
dial = [Control(1, index, m8if = 'Dial'+str(index+1)) for index in range(16)]
button = [Button(2, index, m8if = 'Button'+str(index+1)) for index in range(16)]

alphas = [Attribute('ctrl_layer_alpha', index) for index in range(1, 11)]
selected_layer = Attribute('ctrl_layerStack_focusPosition', 10)
saturate_on = Attribute('ctrl_layer_pixelFX_saturationOn', 0)
saturate_lvl = Attribute('ctrl_layer_pixelFX_saturationLevel', 0)
lightness_on = Attribute('ctrl_layer_pixelFX_lightnessOn', 0)
lightness_lvl = Attribute('ctrl_layer_pixelFX_lightnessLevel', 0)
contrast_on = Attribute('ctrl_layer_pixelFX_contrastOn', 0)
contrast_lvl = Attribute('ctrl_layer_pixelFX_contrastLevel', 0)
modulateR = Attribute('ctrl_layer_color_modulateR', 0)
modulateG = Attribute('ctrl_layer_color_modulateG', 0)
modulateB = Attribute('ctrl_layer_color_modulateB', 0)
additiveR = Attribute('ctrl_layer_color_additiveR', 0)
additiveG = Attribute('ctrl_layer_color_additiveG', 0)
additiveB = Attribute('ctrl_layer_color_additiveB', 0)
scale = Attribute('ctrl_layer_scale_uniform', 0)
speed = Attribute('ctrl_layer_movie_speedFactor', 0)
transition = Attribute('ctrl_layer_transition_duration', 0)
masterInvert = Attribute('ctrl_master_invColor', 10)
masterFlash = Attribute('ctrl_master_flash', 10)
crossfader = Attribute('ctrl_master_crossfader_slider', 10)

# Dials 0, 4, 8 and 12 are four layers' alpha and buttons 0, 4, 8 and 12 select those layers;
# button 15 moves them from layers 1-4 to 6-9
layer_button_defs = [0, 4, 8, 12]
selected_layer_control = RadioControl(controls = [button[index] for index in layer_button_defs], offset = 1)

red_shiftable_control = ToggledShiftableControl(primary_attribute = modulateR, secondary_attribute = additiveR, toggle_on_color = 70., toggle_off_color = 80.)
green_shiftable_control = ToggledShiftableControl(primary_attribute = modulateG, secondary_attribute = additiveG, toggle_on_color = 60., toggle_off_color = 50.)
blue_shiftable_control = ToggledShiftableControl(primary_attribute = modulateB, secondary_attribute = additiveB, toggle_on_color = 30., toggle_off_color = 127.)

def set_layer_offset(value):
	value = int(value)
	selected_layer_control.set_offset(1 if not value else 6)
	for index in range(4):
		dial[layer_button_defs[index]].connect_to(alphas[index+(value*5)])

layer_offset = ScriptAttribute(script_attribute = set_layer_offset)

def update_controls(*a, **k):
	for item in button+dial:
		item.update()
	selected_layer_control.update()
	red_shiftable_control.update_toggle_color()
	green_shiftable_control.update_toggle_color()
	blue_shiftable_control.update_toggle_color()
	set_layer_offset(layer_offset.getValue())

def assign():
	selected_layer_control.connect_to(selected_layer)
	dial[5].connect_to(saturate_lvl)
	dial[6].connect_to(lightness_lvl)
	dial[7].connect_to(contrast_lvl)
	dial[9].connect_to(scale)
	dial[10].connect_to(speed)
	dial[11].connect_to(transition)
	dial[15].connect_to(crossfader)
	button[5].connect_to(saturate_on)
	button[5].set_is_toggle(True)
	button[5]._on_color = 100
	button[6].connect_to(lightness_on)
	button[6].set_is_toggle(True)
	button[6]._on_color = 64
	button[7].connect_to(contrast_on)
	button[7].set_is_toggle(True)
	button[7]._on_color = 115
	button[13].connect_to(masterInvert)
	button[13].set_is_toggle(True)
	button[14].connect_to(masterFlash)
	button[15].connect_to(layer_offset)
	button[15].set_is_toggle(True)
	button[15]._on_color = 10
	button[15]._off_color = 50
	red_shiftable_control.set_shift_control(button[1])
	red_shiftable_control.set_control(dial[1])
	green_shiftable_control.set_shift_control(button[2])
	green_shiftable_control.set_control(dial[2])
	blue_shiftable_control.set_shift_control(button[3])
	blue_shiftable_control.set_control(dial[3])
	selected_layer.off(update_controls)
	selected_layer.on(update_controls)
	update_controls()

def receive_midi(param):
	if not is_link(param.get('source', '')):
		return
	if param.get('message') == 'CONTROL_CHANGE' and param.get('channel') == 1 and param.get('param1') == REFRESH_CC:
		update_controls()
		return
	midi_registry.receive(param)

print('modGrid (dots) b.1 loaded, link %r' % midiEndPoint)
assign()
</string>
	<key>SCRIPT_KEYWORDEVENT</key>
	<string>attribute_registry.receive(keyword, param, layer)
</string>
	<key>SCRIPT_MESSAGE</key>
	<string>if msg == 'outPointList':
	midiEndPoint = param['selection']
	update_midi_destinations()
	update_controls()
